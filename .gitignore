!/financial_rag/model.py
!/financial_rag/requirements.txt
!/financial_rag/requirements.lock.txt
!/tech_rag/
/tech_rag/*
!/tech_rag/*.py
!/tech_rag/.gitignore
!/tech_rag/.env.example
!/tech_rag/requirements*.txt
!/tech_rag/README.txt
!/tech_rag/RUN_*.txt
!/tech_rag/chat_web/
!/tech_rag/integration/
!/tech_rag/evaluation/
