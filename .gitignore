
# Only finance source is tracked in this mixed workspace.
/*
!/.gitignore
!/.gitmodules
!/.gitattributes
!/README.md
!/requirements.txt
!/.github/
!/scripts/
!/docs/
!/启动RAG问答.cmd
!/financial_rag/
