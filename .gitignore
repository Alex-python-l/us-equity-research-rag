!/tech_rag/evaluation/*.py
!/tech_rag/tests/
!/tech_rag/numeric/
!/tech_rag/vendor/
/tech_rag/vendor/*
!/tech_rag/vendor/TradingAgents
**/.env
**/apikey.env
**/.env.enterprise
**/.venv/
**/__pycache__/
**/*.pyc
**/*.log
**/*.sqlite3*
**/state/
**/raw/
**/text/
**/output/
**/node_modules/
**/.pytest_cache/
/docs/superpowers/
